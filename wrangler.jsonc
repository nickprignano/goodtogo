{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goodtogo",
  "main": "worker/dist/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BUDGET",
        "class_name": "BudgetDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BudgetDO"]
    }
  ]
}
