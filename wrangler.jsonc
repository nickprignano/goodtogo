{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goodtogo",
  "main": "worker/dist/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "previews": {},
  "durable_objects": {
    "bindings": [
      {
        "name": "BUDGET",
        "class_name": "BudgetDO"
      },
      {
        "name": "REGISTRY",
        "class_name": "RegistryDO"
      },
      {
        "name": "ROOM",
        "class_name": "RoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BudgetDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RegistryDO", "RoomDO"]
    }
  ]
}
